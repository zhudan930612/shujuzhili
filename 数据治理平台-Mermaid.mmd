%%{init: {'theme':'mc'}}%%
flowchart TD
    subgraph SYNC ["备案系统数据同步"]
        direction TB
        SYNC_SRC["备案系统"] --> SYNC_CFG{"同步配置"}
        SYNC_CFG -->|"自动：每日凌晨 2:00"| SYNC_AUTO["自动同步任务"]
        SYNC_CFG -->|"手动：后台触发"| SYNC_MANU["人工同步"]
        SYNC_AUTO --> SYNC_PROC["更新到后台管理系统<br/>（项目列表页展示）"]
        SYNC_MANU --> SYNC_PROC
        SYNC_PROC --> SYNC_PUSH["推送项目列表至小程序"]
        SYNC_PROC -.->|"失败告警"| SYNC_ERR["异常处理/人工介入"]
    end

    subgraph 采集端 ["📱 巡查员小程序采集"]
        direction TB
        A1["进入项目（扫码/列表选择）"] --> A2["批量拍照"]
        A2 --> A3["照片自动关联项目ID"]
    end

    subgraph PLT ["平台处理（PC端）"]
        direction TB
        B["S3 平台接收并汇聚样本"] --> E["S4 多人多轮标注"]
        E --> G["S5 全量质检"]
        G --> G1{"G1 全量质检裁决"}
        H["S6 高质量数据池 / 入库"]
        S7["S7 周/月抽查 / 强制复判复查"]
        G2{"G2 抽查/复查发现问题？"}

        R1["R1 质检驳回回流"]
        Q["待确认处理<br/>领域工程师完成待确认判定"]
        Q1{"是否规则缺失？"}
        R2["R2 抽查问题回流"]

        B --> E
        E --> G
        G --> G1
        G1 -->|"通过"| H
        H -.->|"周/月抽查"| S7
        S7 --> G2
        G2 ---|"否（未发现问题，留存于 S6）"| H

        subgraph LOOP ["知识库回流"]
            direction TB
            U["P1 新隐患 / 规则缺失发现"]
            U --> V["P2 提报"]
            V --> W["P3 审核"]
            W --> X["P4 更新知识库"]
            X --> Y["P5 口径版本发布/生效（标注/质检/抽查）"]
        end

        G1 -->|"不通过"| R1
        G1 -->|"待确认"| Q
        R1 --> E
        Q --> Q1
        Q1 -->|"是，转P1"| U
        Q1 -->|"否，回G1继续裁决"| G1
        G2 -->|"是"| R2
        R2 --> E

        E -->|"S4发现未覆盖隐患，转P1"| U
        Y --> E
        Y --> G
        Y -.->|"强制复判触发"| S7

        R1 ~~~ Q
        Q ~~~ H
        U ~~~ H
        R2 ~~~ S7
    end

    SYNC_PUSH --> A1
    A3 --> B

    H -.->|"训练侧使用"| M["S8 AI训练与部署"]

    style SYNC fill:#e8f5e9
    style 采集端 fill:#e1f5fe
    style PLT fill:#f5f5f5
    style LOOP fill:#fff3e0
