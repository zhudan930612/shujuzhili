stateDiagram-v2
  [*] --> SamplePending: 样本进入规划流程

  SamplePending: 样本待分配
  AnnotationAssigned: 已分配标注任务
  Annotating: 标注中
  AnnotationDraft: 标注草稿
  AnnotationSubmitted: 标注已提交
  QCWaiting: 待质检

  SamplePending --> AnnotationAssigned: 建立标注任务
  AnnotationAssigned --> Annotating: 标注员领取 / 开始标注
  Annotating --> AnnotationDraft: 保存草稿
  AnnotationDraft --> Annotating: 继续编辑
  Annotating --> AnnotationSubmitted: 提交标注成果
  AnnotationDraft --> AnnotationSubmitted: 草稿补全后提交
  AnnotationSubmitted --> QCWaiting: 进入三轮质检队列

  state "三轮质检状态" as QCFlow {
    [*] --> QC1Waiting

    QC1Waiting: 待一检
    QC1Doing: 一检中
    QC1Scored: 一检已评分
    QC1Passed: 一检通过
    QC1Returned: 一检退回
    QC1Escalated: 一检提交二检

    QC1Waiting --> QC1Doing: 一检员开始检查
    QC1Doing --> QC1Scored: 检查漏标 / 误标 / 框选 / 类别并评分
    QC1Scored --> QC1Returned: 明显不合格
    QC1Scored --> QC1Passed: 基础质量合格且无需复核
    QC1Scored --> QC1Escalated: 需一致性复核

    QC2Waiting: 待二检
    QC2Doing: 二检中
    QC2Scored: 二检已评分
    QC2Passed: 二检通过
    QC2Returned: 二检退回
    QC2Escalated: 二检提交三检

    QC1Escalated --> QC2Waiting: 进入二检队列
    QC2Waiting --> QC2Doing: 二检员开始复核
    QC2Doing --> QC2Scored: 复核一检结论 / 多人差异 / 争议样本
    QC2Scored --> QC2Returned: 质量不稳定或返工价值高
    QC2Scored --> QC2Passed: 质量稳定
    QC2Scored --> QC2Escalated: 重大争议需终审

    QC3Waiting: 待三检
    QC3Doing: 三检中
    QC3Scored: 三检已评分
    QC3Passed: 三检通过
    QC3Returned: 三检退回
    QC3Rejected: 三检剔除

    QC2Escalated --> QC3Waiting: 进入三检队列
    QC3Waiting --> QC3Doing: 终审员开始仲裁
    QC3Doing --> QC3Scored: 复核一检 / 二检差异并给出终审评分
    QC3Scored --> QC3Returned: 仍可返工修复
    QC3Scored --> QC3Rejected: 样本不可用
    QC3Scored --> QC3Passed: 终审通过
  }

  QCWaiting --> QC1Waiting: 生成质检任务

  QC1Returned --> ReturnPending: 生成一检退回
  QC2Returned --> ReturnPending: 生成二检退回
  QC3Returned --> ReturnPending: 生成三检退回

  state "退回返工状态" as ReturnFlow {
    ReturnPending: 待返工
    ReturnReasonRecorded: 已记录退回原因
    ReworkAssigned: 返工已分配
    Reworking: 返工中
    ReworkDraft: 返工草稿
    ReworkSubmitted: 返工已提交
    ReworkCounted: 已累计返工次数与问题类型

    ReturnPending --> ReturnReasonRecorded: 记录退回轮次 / 原因 / 责任标注人
    ReturnReasonRecorded --> ReworkAssigned: 分配给原标注员或指定标注员
    ReworkAssigned --> Reworking: 开始返工
    Reworking --> ReworkDraft: 保存返工草稿
    ReworkDraft --> Reworking: 继续返工
    Reworking --> ReworkSubmitted: 重新提交
    ReworkDraft --> ReworkSubmitted: 草稿补全后重新提交
    ReworkSubmitted --> ReworkCounted: 记录返工次数和错误类型
  }

  ReworkCounted --> QCWaiting: 回到质检队列

  QC1Passed --> TrustedResult: 形成可信标准结果
  QC2Passed --> TrustedResult: 形成可信标准结果
  QC3Passed --> TrustedResult: 形成可信标准结果
  QC3Rejected --> SampleRejected: 样本剔除

  state "高质量数据状态" as DataFlow {
    TrustedResult: 可信标准结果
    QualityDataPending: 待沉淀高质量数据
    QualityDataStored: 已沉淀高质量标注数据
    TrainingCandidate: 训练 / 评测候选数据
    TrainingReady: 可用于模型训练与效果评估

    TrustedResult --> QualityDataPending: 汇总最终框 / 类别 / 属性 / 质检结论
    QualityDataPending --> QualityDataStored: 数据质量校验通过
    QualityDataStored --> TrainingCandidate: 纳入训练 / 评测候选池
    TrainingCandidate --> TrainingReady: 数据集筛选或版本发布
  }

  state "样本剔除状态" as RejectFlow {
    SampleRejected: 样本剔除
    RejectReasonRecorded: 已记录剔除原因
    ExcludedFromTraining: 不进入训练与评测数据

    SampleRejected --> RejectReasonRecorded: 记录不可用原因
    RejectReasonRecorded --> ExcludedFromTraining: 排除出高质量数据
  }

  state "标注人员能力考核状态" as PeopleFlow {
    ScorePending: 待汇总评分
    ScoreAggregated: 已汇总个人得分
    ErrorProfiled: 已统计错误类型
    AbilityProfileUpdated: 已更新能力画像
    InterventionJudging: 是否需要干预
    TrainingRequired: 需要培训 / 复盘 / 规则校准
    PermissionMaintained: 保持正常标注权限
    PermissionAdjusted: 调整标注权限或任务范围

    ScorePending --> ScoreAggregated: 汇总一检 / 二检 / 三检评分
    ScoreAggregated --> ErrorProfiled: 统计漏标 / 误标 / 框选 / 类别错误
    ErrorProfiled --> AbilityProfileUpdated: 形成标注员能力画像
    AbilityProfileUpdated --> InterventionJudging: 判断是否低于质量阈值
    InterventionJudging --> TrainingRequired: 低于阈值或高频返工
    InterventionJudging --> PermissionMaintained: 达标
    TrainingRequired --> PermissionAdjusted: 培训后仍未达标
    TrainingRequired --> PermissionMaintained: 培训后达标
  }

  QC1Scored --> ScorePending: 产生一检评分
  QC2Scored --> ScorePending: 产生二检评分
  QC3Scored --> ScorePending: 产生三检评分
  ReworkCounted --> ScorePending: 产生返工考核记录

  TrainingReady --> [*]: 数据质量闭环完成
  ExcludedFromTraining --> [*]: 样本处理完成
